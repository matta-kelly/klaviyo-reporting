# Copy to .env at the repo root and fill in. The environment wins over this
# file, so an exported variable is used ahead of the value here.

# Postgres warehouse holding the Klaviyo models. Read-only role is enough:
# it needs select on the `int` and `proc` schemas and nothing else.
WAREHOUSE_HOST=db.example.com
WAREHOUSE_USER=readonly_role
WAREHOUSE_DB=warehouse
WAREHOUSE_PASSWORD=
WAREHOUSE_PORT=5432

# Klaviyo private API key, read scopes only.
# Needed for any report covering more than one day: see README, "Unique people
# do not add across days".
KLAVIYO_API_KEY=
